From 67a44c8639026fb35ebb79eb7bc0e9994263d7e0 Mon Sep 17 00:00:00 2001
From: w2e3r4 <324388282+w2e3r4@users.noreply.github.com>
Date: Sat, 14 Nov 2026 18:01:09 +0800
Subject: [PATCH] Fix FA descale batch size in draft decode

Use the query segment count when preparing decode descales after DP padding. Add a regression that checks the actual decode kernel arguments for padded, matching and absent query metadata.
---
 .../attention/flashattention_backend.py       |  6 +-
 .../attention/test_fa3_descale_batch_size.py  | 89 ++++++++++++++++++-
 2 files changed, 93 insertions(+), 2 deletions(-)

diff --git a/python/sglang/srt/layers/attention/flashattention_backend.py b/python/sglang/srt/layers/attention/flashattention_backend.py
index ad1a2be..5b7497b 100644
--- a/python/sglang/srt/layers/attention/flashattention_backend.py
+++ b/python/sglang/srt/layers/attention/flashattention_backend.py
@@ -1945,7 +1945,11 @@ class FlashAttentionBackend(AttentionBackend):
             q_rope,
             k_rope,
             layer,
-            logical_batch_size=forward_batch.batch_size,
+            # DP padding can grow forward_batch.batch_size past the segments in
+            # metadata.cu_seqlens_q, which is what FA validates the descale against.
+            logical_batch_size=fa_descale_batch_size(
+                metadata.cu_seqlens_q, forward_batch.batch_size
+            ),
             kv_head_num=layer.tp_k_head_num,
             is_prefill=False,
         )
diff --git a/test/registered/attention/test_fa3_descale_batch_size.py b/test/registered/attention/test_fa3_descale_batch_size.py
index 00b9817..e7f48de 100644
--- a/test/registered/attention/test_fa3_descale_batch_size.py
+++ b/test/registered/attention/test_fa3_descale_batch_size.py
@@ -18,10 +18,15 @@ attention metadata was already built.
 """
 
 import unittest
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
 
 import torch
 
-from sglang.srt.layers.attention.flashattention_backend import fa_descale_batch_size
+from sglang.srt.layers.attention.flashattention_backend import (
+    FlashAttentionBackend,
+    fa_descale_batch_size,
+)
 from sglang.test.ci.ci_register import register_amd_ci, register_cuda_ci
 
 register_cuda_ci(est_time=5, stage="base-b", runner_config="1-gpu-large")
@@ -45,6 +50,8 @@ class TestFaDescaleBatchSize(unittest.TestCase):
             ([4, 4], 3),
             ([4, 4, 4], 4),
             ([1, 3, 2], 5),
+            # DP-padded draft decode: one query token per request, one padded row.
+            ([1] * 24, 25),
         ]:
             with self.subTest(segments=segments, batch_size=logical_batch_size):
                 cu_seqlens_q = _cu_seqlens_q_from_segments(segments)
@@ -82,6 +89,86 @@ class TestFaDescaleBatchSize(unittest.TestCase):
         """Non-varlen paths keep the logical batch size."""
         self.assertEqual(fa_descale_batch_size(None, 7), 7)
 
+    def test_decode_passes_segment_sized_descales_to_fa(self):
+        """Exercise the decode call site, including DP padding and the fallback."""
+        for segments, logical_batch_size in [(24, 25), (24, 24), (None, 25)]:
+            with self.subTest(segments=segments, batch_size=logical_batch_size):
+                cu_seqlens_q = (
+                    _cu_seqlens_q_from_segments([1] * segments)
+                    if segments is not None
+                    else None
+                )
+                metadata = SimpleNamespace(
+                    cu_seqlens_q=cu_seqlens_q,
+                    page_table=None,
+                    cache_seqlens_int32=None,
+                    max_seq_len_q=1,
+                    scheduler_metadata=None,
+                )
+                backend = SimpleNamespace(
+                    forward_metadata=metadata,
+                    has_local_attention=False,
+                    attention_chunk_size=None,
+                    topk=1,
+                    use_mla=False,
+                    kv_cache_dtype_str="fp8_e4m3",
+                    kv_cache_dtype=torch.float16,
+                    kv_cache_is_mxfp8=False,
+                    fa_impl_ver=3,
+                    use_sliding_window_kv_pool=False,
+                    is_prefill_aware_swa=False,
+                    _decode_uses_static_max_seqlen_k=False,
+                    decode_num_splits=1,
+                    num_splits=1,
+                    _mxfp8_sf_kwargs=Mock(return_value={}),
+                    get_paged_mha_kv_cache=Mock(return_value=(None, None)),
+                )
+                backend.prepare_paged_mha_query = lambda *args, **kwargs: (
+                    FlashAttentionBackend.prepare_paged_mha_query(
+                        backend, *args, **kwargs
+                    )
+                )
+                layer = SimpleNamespace(
+                    is_cross_attention=False,
+                    attn_type=None,
+                    sliding_window_size=None,
+                    tp_q_head_num=2,
+                    tp_k_head_num=2,
+                    head_dim=16,
+                    v_head_dim=16,
+                    scaling=1.0,
+                    logit_cap=0.0,
+                    k_scale=torch.tensor(0.5),
+                    v_scale=torch.tensor(0.25),
+                )
+                forward_batch = SimpleNamespace(
+                    batch_size=logical_batch_size, spec_info=object()
+                )
+                q = torch.zeros(logical_batch_size, 2, 16)
+                with patch(
+                    "sglang.srt.layers.attention.flashattention_backend.flash_attn_with_kvcache",
+                    return_value=q,
+                ) as attention:
+                    FlashAttentionBackend.forward_decode(
+                        backend,
+                        q,
+                        None,
+                        None,
+                        layer,
+                        forward_batch,
+                        save_kv_cache=False,
+                    )
+                attention.assert_called_once()
+                kwargs = attention.call_args.kwargs
+                expected_batch_size = (
+                    segments if segments is not None else logical_batch_size
+                )
+                self.assertIs(kwargs["cu_seqlens_q"], cu_seqlens_q)
+                self.assertEqual(kwargs["k_descale"].shape, (expected_batch_size, 2))
+                self.assertEqual(kwargs["v_descale"].shape, (expected_batch_size, 2))
+                self.assertTrue(torch.all(kwargs["k_descale"] == layer.k_scale))
+                self.assertTrue(torch.all(kwargs["v_descale"] == layer.v_scale))
+
     def test_agrees_when_segments_match_batch_rows(self):
         """The uniform case is unchanged: one segment per batch row."""
         for batch_size in (1, 2, 8, 40):
